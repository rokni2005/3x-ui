# Copy of the real file lives at /etc/balebot/balebot.env (root-only, mode 600).
# setup.sh creates it from this template on first run and never overwrites it
# again, so it's safe to edit by hand and re-run setup.sh to redeploy code.

BALE_BOT_TOKEN=REPLACE_ME
DB_PATH=/var/lib/balebot/balebot.db
PHOTOS_DIR=/var/lib/balebot/photos

# Optional: your own chat ID to receive new-order notifications and use the
# "recent orders" button in the bot itself.
ADMIN_CHAT_ID=

# Manual card-transfer deposit (used whenever PAYMENT_PROVIDER_TOKEN is empty).
DEPOSIT_AMOUNT=200000
DEPOSIT_CARD_NUMBER=xxxx-xxxx-xxxx-xxxx
DEPOSIT_CARD_HOLDER=REPLACE_ME

# Bale wallet online payment (see balebot/README.md "پرداخت آنلاین" section
# before trusting this for real customers -- test with a small real
# transaction and DEBUG_UPDATES=1 first).
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=IRR
PAYMENT_AMOUNT_MULTIPLIER=10
DEBUG_UPDATES=0

# Web admin panel (/fruits, /orders) -- bound to 127.0.0.1 only by default;
# reach it with: ssh -L 8080:127.0.0.1:8080 <user>@<server>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME
ADMIN_LISTEN_ADDR=127.0.0.1:8080
