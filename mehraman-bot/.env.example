# ── بله ──────────────────────────────────────────────
# توکن را فقط اینجا (در فایل .env واقعی) بگذارید؛ هرگز در گیت یا چت نگذارید.
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai

# ── مدل زبانی (یکی را انتخاب کنید) ─────────────────────
# anthropic | gemini | openai   (openai = هر سرویس سازگار با OpenAI، با LLM_BASE_URL)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# فقط برای provider=openai یا پروکسی/گیت‌وی؛ مثال: https://api.openai.com/v1
LLM_BASE_URL=
# اگر سرور شما به سرویس مدل دسترسی مستقیم ندارد (مثلاً http://127.0.0.1:8080)
LLM_PROXY=

# ── مدیریت ───────────────────────────────────────────
# شناسه عددی ادمین‌ها در بله، با کاما جدا شود
ADMIN_IDS=
# چتی که فرم ارجاع به مشاور به آن ارسال می‌شود (شناسه عددی کاربر/گروه مسئول)
# چند شناسه با کاما؛ اولی مسئول اصلی است (فرم برای همه ارسال می‌شود)
REFERRAL_CHAT_ID=

# ── تنظیمات عمومی ────────────────────────────────────
TIMEZONE=Asia/Tehran
DAILY_QUESTION_LIMIT=30
# حداقل امتیاز بازیابی برای اینکه پاسخ «از محتوا» حساب شود (۰ = غیرفعال)
MIN_RETRIEVAL_SCORE=1.2
DATA_DIR=./data
CONTENT_DIR=./content
KNOWLEDGE_DIR=./knowledge
